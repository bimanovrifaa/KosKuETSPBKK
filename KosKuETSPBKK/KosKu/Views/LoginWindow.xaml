<Window x:Class="KosKu.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Masuk • KosKu" Height="620" Width="980" MinHeight="580" MinWidth="900"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{StaticResource BrushAppBg}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*" />
            <ColumnDefinition Width="0.95*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource BrushSidebar}" Padding="48">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource BrushPrimary}" Margin="0,0,12,0">
                        <TextBlock Text="⌂" FontSize="23" Foreground="#06161A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="KosKu" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" />
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource AccentCardStyle}" Padding="30" VerticalAlignment="Center" Margin="0,24,0,24">
                    <StackPanel>
                        <TextBlock Text="Kelola kos,&#x0A;lebih mudah." FontSize="32" FontWeight="Bold" Foreground="White" LineHeight="40" TextWrapping="Wrap" Margin="0,0,0,14" />
                        <TextBlock Text="Kamar, penghuni, kontrak, pembayaran, dan komplain fasilitas dalam satu tempat." FontSize="13" LineHeight="21" Foreground="#F0FBFD" TextWrapping="Wrap" Margin="0,0,0,22" />
                        <TextBlock Text="✓  Data kamar dan penghuni terorganisir" Foreground="White" FontSize="12" Margin="0,0,0,10" />
                        <TextBlock Text="✓  Tagihan dan bukti pembayaran tercatat" Foreground="White" FontSize="12" Margin="0,0,0,10" />
                        <TextBlock Text="✓  Komplain fasilitas mudah dilacak" Foreground="White" FontSize="12" />
                    </StackPanel>
                </Border>
                <TextBlock Grid.Row="2" Text="Sistem Informasi Pengelolaan Kos Mahasiswa" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="42,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource CardBorderStyle}" Padding="32" VerticalAlignment="Center" MaxWidth="420">
                <StackPanel>
                    <TextBlock Text="Selamat datang" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,6" />
                    <TextBlock Text="Masuk untuk melanjutkan ke dashboard KosKu." FontSize="13" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,26" />

                    <TextBlock Text="Username" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,7" />
                    <TextBox x:Name="UsernameBox" Text="admin" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16" />
                    <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,7" />
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,16" />
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource BrushDanger}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <Button Content="Masuk ke KosKu" Style="{StaticResource BtnPrimary}" Height="44" FontSize="13" Click="Login_Click" />
                    <Button Content="Belum punya akun? Daftar sebagai penghuni" Style="{StaticResource BtnOutline}" Height="40" FontSize="12" Margin="0,10,0,0" Click="Register_Click" />
                    <TextBlock Text="Akun demo" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,14,0,7" />
                    <Border Background="{StaticResource BrushSubtleBg}" CornerRadius="14" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="Admin  :  admin / admin123" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,5" />
                            <TextBlock Text="Penghuni: mahasiswa / mahasiswa123" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Data demo tersimpan lokal pada perangkat ini." FontSize="10" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,13,0,0" />
                </StackPanel>
            </Border>
            <TextBlock Grid.Row="1" Text="KosKu © 2026" HorizontalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" Margin="0,18,0,0" />
        </Grid>
        <Button x:Name="ThemeButton" Grid.Column="1" Content="☾ Dark mode" Style="{StaticResource BtnOutline}"
                Click="ToggleTheme_Click" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,12,18,0" Padding="14,0" FontSize="11" Height="36" Panel.ZIndex="5" />
    </Grid>
</Window>
