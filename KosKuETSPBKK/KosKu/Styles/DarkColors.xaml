<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="ColorPrimary">#60A5FA</Color>
    <Color x:Key="ColorPrimaryHover">#3B82F6</Color>
    <Color x:Key="ColorPrimaryLight">#1B3150</Color>
    <Color x:Key="ColorSidebar">#0B1120</Color>
    <Color x:Key="ColorSidebarHover">#1E293B</Color>
    <Color x:Key="ColorSidebarText">#A8B5C8</Color>
    <Color x:Key="ColorSidebarBorder">#243047</Color>
    <Color x:Key="ColorAppBg">#0B1220</Color>
    <Color x:Key="ColorCardBg">#111C30</Color>
    <Color x:Key="ColorBorder">#263449</Color>
    <Color x:Key="ColorTextPrimary">#E5EDF8</Color>
    <Color x:Key="ColorTextSecondary">#9CAEC5</Color>
    <Color x:Key="ColorSuccess">#4ADE80</Color>
    <Color x:Key="ColorWarning">#FBBF24</Color>
    <Color x:Key="ColorDanger">#F87171</Color>
    <Color x:Key="ColorSubtleBg">#182438</Color>
    <Color x:Key="ColorGridAlt">#142036</Color>
    <Color x:Key="ColorGridHeaderBg">#182438</Color>
    <Color x:Key="ColorGridHeaderText">#C0CDDF</Color>
    <Color x:Key="ColorGridLine">#263449</Color>
    <Color x:Key="ColorGridBorder">#2B3A52</Color>
    <Color x:Key="ColorInputBg">#111C30</Color>
    <Color x:Key="ColorInputText">#E5EDF8</Color>
    <Color x:Key="ColorWelcomeBorder">#29466B</Color>
    <Color x:Key="ColorProgressBg">#2B3A52</Color>

    <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}" />
    <SolidColorBrush x:Key="BrushPrimaryHover" Color="{StaticResource ColorPrimaryHover}" />
    <SolidColorBrush x:Key="BrushPrimaryLight" Color="{StaticResource ColorPrimaryLight}" />
    <SolidColorBrush x:Key="BrushSidebar" Color="{StaticResource ColorSidebar}" />
    <SolidColorBrush x:Key="BrushSidebarHover" Color="{StaticResource ColorSidebarHover}" />
    <SolidColorBrush x:Key="BrushSidebarText" Color="{StaticResource ColorSidebarText}" />
    <SolidColorBrush x:Key="BrushSidebarBorder" Color="{StaticResource ColorSidebarBorder}" />
    <SolidColorBrush x:Key="BrushAppBg" Color="{StaticResource ColorAppBg}" />
    <SolidColorBrush x:Key="BrushCardBg" Color="{StaticResource ColorCardBg}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="BrushSubtleBg" Color="{StaticResource ColorSubtleBg}" />
    <SolidColorBrush x:Key="BrushGridAlt" Color="{StaticResource ColorGridAlt}" />
    <SolidColorBrush x:Key="BrushGridHeaderBg" Color="{StaticResource ColorGridHeaderBg}" />
    <SolidColorBrush x:Key="BrushGridHeaderText" Color="{StaticResource ColorGridHeaderText}" />
    <SolidColorBrush x:Key="BrushGridLine" Color="{StaticResource ColorGridLine}" />
    <SolidColorBrush x:Key="BrushGridBorder" Color="{StaticResource ColorGridBorder}" />
    <SolidColorBrush x:Key="BrushInputBg" Color="{StaticResource ColorInputBg}" />
    <SolidColorBrush x:Key="BrushInputText" Color="{StaticResource ColorInputText}" />
    <SolidColorBrush x:Key="BrushWelcomeBorder" Color="{StaticResource ColorWelcomeBorder}" />
    <SolidColorBrush x:Key="BrushProgressBg" Color="{StaticResource ColorProgressBg}" />
</ResourceDictionary>
