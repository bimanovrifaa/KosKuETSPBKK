<Window x:Class="KosKu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KosKu — Sistem Informasi Pengelolaan Kos Mahasiswa"
        Height="820" Width="1360" MinHeight="700" MinWidth="1050"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BrushAppBg}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource BrushSidebar}" Padding="16,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="6,0,0,30">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource BrushPrimary}" Margin="0,0,10,0">
                            <TextBlock Text="⌂" FontSize="21" Foreground="#06161A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="KosKu" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock Text="Boarding Management" FontSize="10" Foreground="{StaticResource BrushSidebarText}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="MENU UTAMA" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="12,0,0,10" />
                    <Button x:Name="BtnDashboard" Style="{StaticResource SidebarNavButton}" Click="NavDashboard_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="▦" Width="28" FontSize="16" /><TextBlock Text="Dashboard" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button x:Name="BtnRooms" Style="{StaticResource SidebarNavButton}" Click="NavRooms_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="▤" Width="28" FontSize="16" /><TextBlock Text="Manajemen Kamar" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button x:Name="BtnTenants" Style="{StaticResource SidebarNavButton}" Click="NavTenants_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="♙" Width="28" FontSize="16" /><TextBlock Text="Data Penghuni" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button x:Name="BtnContracts" Style="{StaticResource SidebarNavButton}" Click="NavContracts_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="▣" Width="28" FontSize="16" /><TextBlock Text="Kontrak Sewa" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button x:Name="BtnPayments" Style="{StaticResource SidebarNavButton}" Click="NavPayments_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="Rp" Width="28" FontSize="12" FontWeight="Bold" /><TextBlock Text="Pembayaran" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button x:Name="BtnComplaints" Style="{StaticResource SidebarNavButton}" Click="NavComplaints_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="◇" Width="28" FontSize="16" /><TextBlock Text="Komplain Fasilitas" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button x:Name="BtnReports" Style="{StaticResource SidebarNavButton}" Click="NavReports_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="▥" Width="28" FontSize="16" /><TextBlock Text="Laporan &amp; Ekspor" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Border Style="{StaticResource AccentCardStyle}" Margin="0,0,0,16" Padding="18">
                        <StackPanel>
                            <TextBlock Text="KosKu" FontSize="20" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="Pengelolaan kos mahasiswa yang rapi, dari kamar sampai pembayaran." FontSize="11" LineHeight="16" Foreground="#F0FBFD" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Grid Margin="4,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource BrushInputBg}" Margin="0,0,10,0">
                            <TextBlock Text="●" Foreground="{StaticResource BrushPrimary}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="UserNameText" Text="Pengguna" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="UserRoleText" Text="Role" FontSize="10" Foreground="{StaticResource BrushSidebarText}" />
                        </StackPanel>
                    </Grid>
                    <Button Content="⇤   Keluar" Style="{StaticResource SidebarNavButton}" Foreground="{StaticResource BrushSidebarText}" Click="Logout_Click" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="86" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="28,0,28,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Dashboard KosKu" FontSize="26" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                    <TextBlock x:Name="HeaderSubtitle" Text="Kelola operasional kos dari satu tempat" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{StaticResource BrushCardBg}" CornerRadius="22" Padding="18,0" Height="44" Margin="0,0,10,0">
                        <TextBlock x:Name="TodayText" Text="20 Okt 2026" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" />
                    </Border>
                    <Button x:Name="ThemeButton" Content="☾ Dark mode" Style="{StaticResource BtnOutline}" Click="ToggleTheme_Click" Padding="16,0" Height="44" FontSize="11" Margin="0,0,10,0" />
                    <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource BrushPrimaryLight}">
                        <TextBlock Text="⌂" FontSize="20" Foreground="{StaticResource BrushPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Grid>
            <ContentControl x:Name="ContentHost" Grid.Row="1" Background="{StaticResource BrushAppBg}" />
        </Grid>
    </Grid>
</Window>
